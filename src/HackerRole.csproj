<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AssemblyName>HackerRole</AssemblyName>
        <RootNamespace>HackerRole</RootNamespace>
        <Version>0.1.0</Version>
        <Description>The Hacker: a new Impostor role for Among Us</Description>
        <Nullable>disable</Nullable>
        <DebugType>embedded</DebugType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Same version set as other maintained role mods (Reactor 2.3.1 / game libs 2024.10.29). -->
    <ItemGroup>
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2024.10.29" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.697" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Reactor" Version="2.3.1" Private="false" />
    </ItemGroup>

    <!-- dotnet build -p:AmongUs="C:/path/to/Among Us" copies the dll straight into the game. -->
    <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" />
    </Target>
</Project>
